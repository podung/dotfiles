# Tracked in ~/dotfiles. Private or machine-specific hosts go in ~/.ssh/config.local
# (untracked; can live in secret_files). It's included first so it can override
# anything below: ssh uses the first value it finds for each option.
Include ~/.ssh/config.local

# GitHub auth key lives in 1Password; the .pub file only tells the agent which key
# to offer. IdentitiesOnly stops it from trying every key in the vault.
Host github.com
  User git
  IdentityFile ~/.ssh/github-auth.pub
  IdentitiesOnly yes

# All keys come from the 1Password SSH agent (Settings → Developer → Use the SSH agent)
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
