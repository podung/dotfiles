#!/bin/bash
#
# Picture-by-picture / picture-in-picture on a Dell monitor over DDC (m1ddc).
#
#   dell-pbp split       50/50 side by side
#   dell-pbp 75-25       main source large, second small
#   dell-pbp 25-75       main source small, second large
#   dell-pbp pip-small   second source in a small window
#   dell-pbp pip-large   second source in a large window
#   dell-pbp swap        swap which source is main
#   dell-pbp off         main source only
#   dell-pbp status      show the current main input
#
# Nothing assumes which computer is on which port. The main source is read from
# the monitor each time; the second source is the other port in DELL_PBP_INPUTS.
# Only change that list if a computer moves to a different kind of port.
#
#   DELL_PBP_INPUTS   ports in use (default "25 15" = USB-C and DisplayPort 1)
#   DELL_PBP_DISPLAY  name to match in `m1ddc display list` (default "DELL")
#
# DDC can't read the PBP mode back, only the main input.

set -euo pipefail

M1DDC=/opt/homebrew/bin/m1ddc
read -r -a INPUTS <<< "${DELL_PBP_INPUTS:-25 15}"
DISPLAY_NAME="${DELL_PBP_DISPLAY:-DELL}"

input_name() {
  case "$1" in
    15) echo "DisplayPort 1" ;; 16) echo "DisplayPort 2" ;;
    17) echo "HDMI 1" ;;        18) echo "HDMI 2" ;;
    25|27) echo "USB-C" ;;      *) echo "input $1" ;;
  esac
}

die() { echo "dell-pbp: $*" >&2; exit 1; }

# m1ddc picks displays by index; find the Dell's. Its index and UUID can change
# when it reconnects, and it's briefly missing right after a mode change.
DISPLAY_INDEX=""
for _ in 1 2 3 4 5; do
  DISPLAY_INDEX="$("$M1DDC" display list | grep -i "$DISPLAY_NAME" | head -1 | sed -E 's/^\[([0-9]+)\].*/\1/' || true)"
  [ -n "$DISPLAY_INDEX" ] && break
  sleep 1
done
[ -n "$DISPLAY_INDEX" ] || die "no display matching \"$DISPLAY_NAME\" (see: m1ddc display list)"

ddc() { "$M1DDC" display "$DISPLAY_INDEX" "$@"; }

main_input() {
  # The monitor sometimes returns nothing right after a mode change; retry
  local v
  for _ in 1 2 3 4 5; do
    v="$(ddc get input 2>/dev/null || true)"
    [ -n "$v" ] && { echo "$v"; return; }
    sleep 1
  done
  die "couldn't read the current input"
}

second_input() {
  local main="$1" i
  for i in "${INPUTS[@]}"; do
    [ "$i" != "$main" ] && { echo "$i"; return; }
  done
  die "main input $main is the only one in DELL_PBP_INPUTS (${INPUTS[*]})"
}

pbp() {
  # Set the second source first, then the layout
  local main second
  main="$(main_input)"; second="$(second_input "$main")"
  ddc set pbp-input "$second" >/dev/null
  ddc set pbp "$1" >/dev/null
}

case "${1:-}" in
  split)     pbp 36 ;;
  75-25)     pbp 44 ;;
  25-75)     pbp 43 ;;
  pip-small) pbp 33 ;;
  pip-large) pbp 34 ;;
  off)       ddc set pbp 0 >/dev/null ;;
  swap)
    main="$(main_input)"
    second="$(second_input "$main")"
    ddc set input "$second" >/dev/null
    ddc set pbp-input "$main" >/dev/null
    ;;
  status)
    main="$(main_input)"; second="$(second_input "$main")"
    echo "Main: $(input_name "$main") ($main). Second: $(input_name "$second") ($second)."
    ;;
  *) sed -n '3,21s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac
