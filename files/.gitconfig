[user]
  email = joe.depung@gmail.com
  name = Joe DePung

[alias]
  lg = log --graph --abbrev-commit --date=relative
  st = status
  br = branch
  ci = commit
  co = checkout
  di = diff
  dc = diff --cached
  aa = add --all
  amend = commit --amend
  staged = diff --staged

[format]
  pretty=format:%C(yellow)%h%Creset -%C(red)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset
[core]
  editor = vim -f
  pager = delta
[init]
  defaultBranch = main
[pull]
  ff = only
[push]
  default = simple
  autoSetupRemote = true
[fetch]
  prune = true
[rerere]
  enabled = true
[merge]
  conflictstyle = zdiff3
[diff]
  algorithm = histogram
  colorMoved = default
[difftool "idiff"]
  cmd = diff -i --ignore-space-change $LOCAL $REMOTE

[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true

# Work identity for anything under ~/projects/work/ (file lives in secret_files, not git).
# Keep this last so it overrides [user] above.
[includeIf "gitdir:~/projects/work/"]
  path = ~/.gitconfig-work
