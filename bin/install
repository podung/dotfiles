#!/bin/bash
#
# Bootstrap a Mac from a bare install. Safe to re-run.
#   1. Homebrew  2. Brewfile  3. stow dotfiles  4. shell/vim/tmux plugins
#   5. mise tools  6. Claude Code (native, self-updating)

set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
source "$DOTFILES/bin/helpers.sh"

STOW_PACKAGES=(files secret_files)

# --- Homebrew -----------------------------------------------------------------
if [ ! -x /opt/homebrew/bin/brew ]; then
  fancy_echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

fancy_echo "Installing Brewfile..."
brew bundle --file="$DOTFILES/Brewfile"

# --- Dotfiles -----------------------------------------------------------------
# stow refuses to replace real files, so move any aside first (e.g. the ~/.zshrc
# the Claude Code installer creates).
fancy_echo "Stowing dotfiles..."
for pkg in "${STOW_PACKAGES[@]}"; do
  (cd "$DOTFILES/$pkg" && find . \( -type f -o -type l \) ! -name .DS_Store ! -name .keep) | while read -r rel; do
    target="$HOME/${rel#./}"
    if [ -e "$target" ] && [ ! -L "$target" ]; then
      fancy_echo "Moving existing %s to %s.pre-dotfiles" "$target" "$target"
      mv "$target" "$target.pre-dotfiles"
    fi
  done
done

# --no-folding: create real directories (~/.config, ~/.vim) and link only files,
# so anything apps write there doesn't end up in this repo.
stow --no-folding --ignore='\.DS_Store' --ignore='\.keep' \
  -d "$DOTFILES" -t "$HOME" "${STOW_PACKAGES[@]}"

# --- Plugins ------------------------------------------------------------------
fancy_echo "Installing zsh plugins (antidote)..."
zsh -i -c exit

fancy_echo "Installing vim plugins (vim-plug)..."
vim -Es -u "$HOME/.vimrc" +'PlugInstall --sync' +qa || true

fancy_echo "Installing tmux plugins (tpm)..."
[ -d "$HOME/.tmux/plugins/tpm" ] || git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
"$HOME/.tmux/plugins/tpm/bin/install_plugins"

# --- Tools --------------------------------------------------------------------
fancy_echo "Installing mise tools (~/.config/mise/config.toml)..."
mise install

if [ ! -x "$HOME/.local/bin/claude" ]; then
  fancy_echo "Installing Claude Code (native installer, auto-updates)..."
  curl -fsSL https://claude.ai/install.sh | bash
fi

fancy_echo "Installation complete. Next:"
fancy_echo "  * Open Ghostty (new shell picks everything up)"
fancy_echo "  * $DOTFILES/bin/osx-settings.sh, then log out and back in"
fancy_echo "  * Optional: brew bundle --file=$DOTFILES/Brewfile.docker"
fancy_echo "  * gh auth login"
